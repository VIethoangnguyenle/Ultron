{
  "card_id": "auth.login_new_device.app",
  "flow": "dang-nhap",
  "flow_step": "B2b",
  "title": "Đăng nhập trên thiết bị mới - kênh App (MB)",
  "channel": "APP",
  "method": "POST",
  "path": "/api/v1/app/nonfinancial/auth/login-new-device",
  "version": "v1",
  "headers": [
    {
      "name": "Content-Type",
      "required": true,
      "sample": "application/json"
    }
  ],
  "client_must_know": [
    "Chỉ dùng khi khách đăng nhập trên thiết bị CHƯA được cấp phép; thiết bị đã biết thì dùng API đăng nhập thường.",
    "Trước khi gọi API này, thiết bị cũ phải thực hiện luồng cấp phép (permit-new-device: validate -> init -> confirm).",
    "Kích hoạt sai quá số lần cho phép sẽ bị tạm khoá (mã 100035)."
  ],
  "request_fields": [
    {
      "name": "username",
      "type": "string",
      "required": true,
      "example": "namdx",
      "note": "Tên đăng nhập"
    },
    {
      "name": "password",
      "type": "string",
      "required": false,
      "example": "Vnpay@123",
      "note": "Bắt buộc khi loginType = PASSWORD"
    },
    {
      "name": "loginType",
      "type": "enum",
      "enum": [
        "PASSWORD",
        "BIOMETRIC"
      ],
      "required": false,
      "example": "PASSWORD"
    },
    {
      "name": "softOtpStatus",
      "type": "enum",
      "enum": [
        "INACTIVE",
        "ACTIVE",
        "LOCK"
      ],
      "required": false,
      "example": "INACTIVE"
    },
    {
      "name": "sessionId",
      "type": "string",
      "required": false,
      "example": "9265ccf6-3fa6-4f29-a851-c05b79846009",
      "note": "ID phiên đăng nhập"
    },
    {
      "name": "clientId",
      "type": "integer",
      "required": false,
      "example": 123456,
      "note": "ID thiết bị (0 nếu chưa biết)"
    },
    {
      "name": "customerId",
      "type": "integer",
      "required": false,
      "example": 0,
      "note": "ID khách hàng (0 nếu chưa biết)"
    },
    {
      "name": "unlockBootloader",
      "type": "boolean",
      "required": false,
      "example": false,
      "note": "Cờ Android đã mở khoá bootloader"
    },
    {
      "name": "mainColor",
      "type": "string",
      "required": false,
      "example": "456456",
      "note": "Màu chủ đạo app"
    },
    {
      "name": "appPackage",
      "type": "string",
      "required": false,
      "example": "vn.vnpay.vbsme",
      "note": "Package app"
    },
    {
      "name": "signature",
      "type": "string",
      "required": false,
      "example": "123456",
      "note": "Chữ ký giữa server và client"
    },
    {
      "name": "DT",
      "type": "enum",
      "enum": [
        "IOS",
        "ANDROID",
        "WEB",
        "UNKNOWN"
      ],
      "required": false,
      "example": "IOS",
      "note": "Hệ điều hành thiết bị"
    },
    {
      "name": "E",
      "type": "string",
      "required": false,
      "example": "3509823445",
      "note": "Raw IMEI"
    },
    {
      "name": "PS",
      "type": "string",
      "required": false,
      "example": "IS_SAFE",
      "note": "Phone Security"
    },
    {
      "name": "PM",
      "type": "string",
      "required": false,
      "example": "iPhone12",
      "note": "Tên thiết bị"
    },
    {
      "name": "VER",
      "type": "string",
      "required": false,
      "example": "1.0.3",
      "note": "Phiên bản app"
    },
    {
      "name": "OV",
      "type": "string",
      "required": false,
      "example": "12.0.7",
      "note": "Phiên bản hệ điều hành"
    }
  ],
  "response_data_extra": [
    {
      "name": "nextStep",
      "type": "enum",
      "enum": [
        "NORMAL",
        "LOGIN_FIRST",
        "ANOTHER",
        "RESET_PASSWORD",
        "EXPIRED_PASSWORD",
        "REQUIRE_COLLECT",
        "CHANGE_PASSWORD_MIGRATE",
        "RESET_PASSWORD_MIGRATE",
        "EXPIRED_PASSWORD_MIGRATE"
      ],
      "example": "ANOTHER",
      "note": "ANOTHER = đăng nhập thiết bị khác -> client gọi bước kích hoạt"
    },
    {
      "name": "otpToken",
      "type": "string",
      "example": "<otp-token>",
      "note": "Token dùng cho luồng OTP kích hoạt"
    },
    {
      "name": "otpExpireTime",
      "type": "integer",
      "example": 300,
      "note": "Thời gian hết hạn OTP (giây)"
    },
    {
      "name": "otpAction",
      "type": "string",
      "example": "SEND_OTP",
      "note": "Action cho API resend OTP"
    },
    {
      "name": "ekycSignature",
      "type": "string",
      "example": "<ekyc-signature>",
      "note": "Chữ ký so khớp với đầu eKYC"
    }
  ],
  "errors": [
    {
      "code": "100030",
      "message": "Không tìm thấy thiết bị",
      "cause": "Thiết bị chưa có trong hệ thống",
      "fix": "Kiểm tra clientId/IMEI gửi lên"
    },
    {
      "code": "100035",
      "message": "Tài khoản bị tạm khóa do kích hoạt sai quá số lần.",
      "cause": "Kích hoạt thiết bị mới sai quá số lần",
      "fix": "Chờ hết thời gian khoá hoặc liên hệ tổng đài"
    },
    {
      "code": "003001",
      "message": "Tài khoản của Quý khách đã bị khóa bởi quản trị viên.",
      "cause": "Tài khoản bị khoá",
      "fix": "Liên hệ QTV doanh nghiệp"
    },
    {
      "code": "100033",
      "message": "Tài khoản bị tạm khóa do nhập mật khẩu sai quá số lần.",
      "cause": "Sai mật khẩu nhiều lần",
      "fix": "Chờ hết thời gian tạm khoá"
    }
  ],
  "notes": [
    "Bước chuyển tiếp: sau khi API này trả nextStep = ANOTHER, client gọi API kích hoạt (active)."
  ],
