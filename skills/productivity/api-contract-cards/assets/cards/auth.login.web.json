{
  "card_id": "auth.login.web",
  "flow": "dang-nhap",
  "flow_step": "B2",
  "title": "Đăng nhập - kênh Web (IB)",
  "channel": "WEB",
  "method": "POST",
  "path": "/api/v1/web/nonfinancial/auth/login",
  "version": "v1",
  "headers": [
    {
      "name": "Content-Type",
      "required": true,
      "sample": "application/json"
    },
    {
      "name": "Accept-Language",
      "required": false,
      "sample": "vi"
    }
  ],
  "client_must_know": [
    "Kênh Web: HTTP status trả về ĐÚNG theo loại lỗi (khác với kênh App luôn trả 200) => client xử lý được theo cả 2 cách: HTTP status hoặc field `code`.",
    "Bắt buộc gửi kèm captchaToken + captchaValue (lấy từ API sinh captcha của kênh Web) — thiếu là lỗi 100005."
  ],
  "request_fields": [
    {
      "name": "username",
      "type": "string",
      "required": true,
      "example": "namdx",
      "note": "Tên đăng nhập"
    },
    {
      "name": "password",
      "type": "string",
      "required": false,
      "example": "Vnpay@123",
      "note": "Bắt buộc khi loginType = PASSWORD"
    },
    {
      "name": "loginType",
      "type": "enum",
      "enum": [
        "PASSWORD",
        "BIOMETRIC"
      ],
      "required": false,
      "example": "PASSWORD",
      "note": "Loại đăng nhập"
    },
    {
      "name": "softOtpStatus",
      "type": "enum",
      "enum": [
        "INACTIVE",
        "ACTIVE",
        "LOCK"
      ],
      "required": false,
      "example": "INACTIVE",
      "note": "Trạng thái Soft OTP trên SDK"
    },
    {
      "name": "captchaToken",
      "type": "string",
      "required": true,
      "example": "<captcha-token>",
      "note": "Token captcha - BẮT BUỘC"
    },
    {
      "name": "captchaValue",
      "type": "string",
      "required": true,
      "example": "A1B2C",
      "note": "Giá trị captcha người dùng nhập - BẮT BUỘC"
    },
    {
      "name": "sessionId",
      "type": "string",
      "required": false,
      "example": "9265ccf6-3fa6-4f29-a851-c05b79846009",
      "note": "ID phiên đăng nhập"
    },
    {
      "name": "clientId",
      "type": "integer",
      "required": false,
      "example": 123456,
      "note": "ID thiết bị (0 nếu chưa biết)"
    },
    {
      "name": "customerId",
      "type": "integer",
      "required": false,
      "example": 0,
      "note": "ID khách hàng (0 nếu chưa biết)"
    },
    {
      "name": "unlockBootloader",
      "type": "boolean",
      "required": false,
      "example": false,
      "note": "Cờ Android đã mở khoá bootloader"
    },
    {
      "name": "mainColor",
      "type": "string",
      "required": false,
      "example": "456456",
      "note": "Màu chủ đạo app"
    },
    {
      "name": "appPackage",
      "type": "string",
      "required": false,
      "example": "vn.vnpay.vbsme",
      "note": "Package app"
    },
    {
      "name": "signature",
      "type": "string",
      "required": false,
      "example": "123456",
      "note": "Chữ ký giữa server và client"
    },
    {
      "name": "DT",
      "type": "enum",
      "enum": [
        "IOS",
        "ANDROID",
        "WEB",
        "UNKNOWN"
      ],
      "required": false,
      "example": "IOS",
      "note": "Hệ điều hành thiết bị"
    },
    {
      "name": "E",
      "type": "string",
      "required": false,
      "example": "3509823445",
      "note": "Raw IMEI"
    },
    {
      "name": "PS",
      "type": "string",
      "required": false,
      "example": "IS_SAFE",
      "note": "Phone Security"
    },
    {
      "name": "PM",
      "type": "string",
      "required": false,
      "example": "iPhone12",
      "note": "Tên thiết bị"
    },
    {
      "name": "VER",
      "type": "string",
      "required": false,
      "example": "1.0.3",
      "note": "Phiên bản app"
    },
    {
      "name": "OV",
      "type": "string",
      "required": false,
      "example": "12.0.7",
      "note": "Phiên bản hệ điều hành"
    }
  ],
  "response_data_extra": [
    {
      "name": "nextStep",
      "type": "enum",
      "enum": [
        "NORMAL",
        "LOGIN_FIRST",
        "ANOTHER",
        "RESET_PASSWORD",
        "EXPIRED_PASSWORD",
        "REQUIRE_COLLECT",
        "CHANGE_PASSWORD_MIGRATE",
        "RESET_PASSWORD_MIGRATE",
        "EXPIRED_PASSWORD_MIGRATE"
      ],
      "example": "NORMAL",
      "note": "Điều hướng màn hình tiếp theo phía client"
    },
    {
      "name": "otpToken",
      "type": "string",
      "example": "<otp-token>",
      "note": "Token dùng cho luồng gửi OTP"
    },
    {
      "name": "otpExpireTime",
      "type": "integer",
      "example": 300,
      "note": "Thời gian hết hạn OTP (giây)"
    },
    {
      "name": "otpAction",
      "type": "string",
      "example": "SEND_OTP",
      "note": "Action dùng cho API resend OTP"
    },
    {
      "name": "ekycSignature",
      "type": "string",
      "example": "<ekyc-signature>",
      "note": "Chữ ký so khớp với đầu eKYC"
    }
  ],
  "errors": [
    {
      "code": "100005",
      "message": "Thông tin dữ liệu không chính xác.",
      "cause": "Thiếu captcha hoặc thiếu field bắt buộc",
      "fix": "Bổ sung captchaToken/captchaValue",
      "input_error": true,
      "field_errors": {
        "username": "Trường này là bắt buộc"
      }
    },
    {
      "code": "100017",
      "message": "Capcha không chính xác. Vui lòng nhập lại",
      "cause": "Captcha hết hạn",
      "fix": "Sinh lại captcha rồi đăng nhập lại"
    },
    {
      "code": "100018",
      "message": "Capcha không chính xác. Vui lòng nhập lại",
      "cause": "Captcha sai",
      "fix": "Nhập lại captcha"
    },
    {
      "code": "100008",
      "message": "Tên đăng nhập hoặc mật khẩu không hợp lệ.",
      "cause": "Sai tài khoản/mật khẩu",
      "fix": "Kiểm tra lại thông tin"
    },
    {
      "code": "996033",
      "message": "Hết phiên đăng nhập.",
      "cause": "Token hết hiệu lực",
      "fix": "Gọi API refresh-token rồi thực hiện lại"
    }
  ],
  "notes": [
    "Kênh Web không có luồng 'xin cấp phép đăng nhập thiết bị khác' (chỉ App có).",
    "Dùng chung cửa đăng nhập cho cả đăng nhập thiết bị mới (không tách API riêng như App)."
  ],
  "response_data_fields": [
