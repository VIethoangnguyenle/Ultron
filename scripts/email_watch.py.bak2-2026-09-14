#!/usr/bin/env python3
"""Theo doi mail QUAN TRONG lien quan tới Hoàng → ping DM. Thuần script, 0 token.

Từ 2026-09-14 CHỈ còn hai loại mail được ping, mọi thứ khác im lặng:
  (a) LỜI MỜI HỌP NỘI BỘ — có đính kèm .ics hoặc tiêu đề kiểu mời/book họp,
      và người gửi thuộc domain nội bộ;
  (b) REVIEW TÀI LIỆU DỰ ÁN — tiêu đề/nội dung có đủ ba nhóm từ khoá:
      review + tài liệu/document + tên dự án.
Cách chấm điểm cũ (sự cố / VIP / cần phản hồi) đã bỏ vì ping quá rộng.

  email_watch.py                 # chạy thật (cron gọi cái này)
  email_watch.py --dry-run       # in ra, không gửi, không ghi state
  email_watch.py --explain       # soi mọi mail: vì sao ping / vì sao bỏ
  email_watch.py --lookback 7    # cửa sổ xét (mặc định 2 ngày)
  email_watch.py --reset-seen    # xoá baseline (lần sau coi như chạy lần đầu)

Từ khoá + domain để ở state/email_watch_config.json (tự tạo mặc định) — chỉnh ở đó,
không phải sửa code.
"""
from __future__ import annotations

import argparse
import base64
import datetime as dt
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))
import gmail  # noqa: E402

DM_HOANG = "spaces/0dniIqAAAAE"
SEND = SCRIPT_DIR / "gchat_send_text.py"
STATE = Path.home() / ".hermes" / "state" / "email_watch_seen.json"
CONFIG = Path.home() / ".hermes" / "state" / "email_watch_config.json"
ME = "hoangnlv@vnpay.vn"

# Nguồn rác — lọc ngay ở query Gmail cho đỡ tải về (giữ nguyên như bản cũ).
NOISE = ["from:jira", "from:ttnb@vnpay.vn", "from:daotao@vnpay.vn",
         "from:noreply", "from:no-reply", "from:notification",
         "from:marketing@vnpay.vn", "from:hrmpro", "from:tuyendung",
         "from:recruit", "from:sumeru"]

DEFAULT_CONFIG = {
    "internal_domains": ["vnpay.vn"],
    # Đúng danh sách Hoàng chốt. Cố tình KHÔNG có "thư mời" trống trơn: thư mời lễ lạt
    # toàn công ty cũng khớp, mà lời mời họp thật thì đã bắt được bằng đính kèm .ics.
    "invite_subject_keywords": ["invitation", "lời mời", "loi moi", "mời họp", "moi hop",
                                "book họp", "book hop", "booking", "meeting invite"],
    # Thư báo HUỶ / nhận / từ chối cũng kèm .ics (METHOD:CANCEL, REPLY) nhưng không phải
    # lời mời — ping mấy cái này đúng là thứ ồn ào cần bỏ.
    "invite_skip_subject_keywords": ["sự kiện đã hủy", "su kien da huy", "đã hủy:", "da huy:",
                                     "canceled event", "cancelled event", "huỷ lịch",
                                     "accepted:", "declined:", "tentative:"],
    "review_keywords": ["review", "rà soát", "ra soat", "góp ý", "gop y"],
    "document_keywords": ["tài liệu", "tai lieu", "document", "đặc tả", "dac ta", "srs"],
    "project_keywords": ["sme", "vbsme", "dự án", "du an", "vietbank"],
}


def load_config() -> dict:
    """Đọc config lọc; thiếu file thì tạo mặc định, thiếu khoá thì bù khoá."""
    if not CONFIG.exists():
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps(DEFAULT_CONFIG, ensure_ascii=False, indent=2), encoding="utf-8")
        return dict(DEFAULT_CONFIG)
    try:
        cfg = json.loads(CONFIG.read_text(encoding="utf-8"))
    except Exception:
        return dict(DEFAULT_CONFIG)
    return {**DEFAULT_CONFIG, **cfg}


def addr(raw: str) -> str:
    m = re.search(r"<([^>]+)>", raw or "")
    return (m.group(1) if m else (raw or "")).strip().lower()


def load_state() -> dict:
    if STATE.exists():
        try:
            return json.loads(STATE.read_text())
        except Exception:
            pass
    return {"seen": {}}


def save_state(st: dict) -> None:
    cut = (dt.date.today() - dt.timedelta(days=30)).isoformat()
    st["seen"] = {k: v for k, v in st["seen"].items() if str(v)[:10] >= cut}
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(st, ensure_ascii=False, indent=1))


# --- bóc nội dung thư ----------------------------------------------------------

def _walk(part: dict):
    yield part
    for sub in part.get("parts") or []:
        yield from _walk(sub)


def parts_info(payload: dict) -> tuple[list[str], str]:
    """Trả về (danh sách tên/kiểu đính kèm, phần text thuần đã cắt gọn)."""
    names, text = [], ""
    for part in _walk(payload or {}):
        mime = (part.get("mimeType") or "").lower()
        fname = part.get("filename") or ""
        if fname:
            names.append(fname.lower())
        if mime == "text/calendar":
            names.append("invite.ics")
        if mime != "text/plain" or text:
            continue
        data = part.get("body", {}).get("data")
        if data:
            text = base64.urlsafe_b64decode(data).decode("utf-8", "replace")[:4000]
    return names, text


def has_ics(attachments: list[str]) -> bool:
    return any(n.endswith(".ics") for n in attachments)


def is_internal(sender: str, cfg: dict) -> bool:
    a = addr(sender)
    return any(a.endswith("@" + d.lower()) or a.endswith("." + d.lower())
               for d in cfg["internal_domains"])


def classify(hdr: dict, attachments: list[str], body: str, cfg: dict) -> tuple[str | None, list[str]]:
    """Loại thư + lý do. None = im lặng, không ping.

    Whitelist thuần: không khớp (a) hoặc (b) thì bỏ, không có điểm số nào cả.
    """
    subj = (hdr.get("Subject") or "").lower()
    blob = f"{subj} {body}".lower()
    sender = hdr.get("From") or ""
    internal = is_internal(sender, cfg)

    ics = has_ics(attachments)
    subj_invite = [k for k in cfg["invite_subject_keywords"] if k.lower() in subj]
    cancel = any(k.lower() in subj for k in cfg["invite_skip_subject_keywords"])
    if internal and not cancel and (ics or subj_invite):
        why = ["đính kèm .ics"] if ics else ["tiêu đề mời họp: " + ", ".join(subj_invite[:2])]
        return "invite", ["mời họp nội bộ"] + why

    rv = [k for k in cfg["review_keywords"] if k.lower() in blob]
    doc = [k for k in cfg["document_keywords"] if k.lower() in blob]
    proj = [k for k in cfg["project_keywords"] if k.lower() in blob]
    if rv and doc and proj:
        return "review", ["review tài liệu dự án",
                          f"{rv[0]} + {doc[0]} + {proj[0]}"]
    return None, []


def why_skipped(hdr: dict, attachments: list[str], body: str, cfg: dict) -> str:
    """Câu ngắn giải thích vì sao im lặng — chỉ dùng cho --explain."""
    subj = (hdr.get("Subject") or "").lower()
    blob = f"{subj} {body}".lower()
    if any(k.lower() in subj for k in cfg["invite_skip_subject_keywords"]):
        return "thư báo huỷ/nhận/từ chối lịch, không phải lời mời"
    if has_ics(attachments) or any(k.lower() in subj for k in cfg["invite_subject_keywords"]):
        return "giống lời mời họp nhưng người gửi không thuộc domain nội bộ"
    missing = []
    if not any(k.lower() in blob for k in cfg["review_keywords"]):
        missing.append("review")
    if not any(k.lower() in blob for k in cfg["document_keywords"]):
        missing.append("tài liệu")
    if not any(k.lower() in blob for k in cfg["project_keywords"]):
        missing.append("tên dự án")
    return "không phải mời họp; thiếu " + "/".join(missing)


# --- đọc hộp thư (giữ nguyên cách đọc, chỉ lấy thêm body + đính kèm) -----------

def candidates(s, lookback: int) -> list[dict]:
    q = f"in:inbox is:unread newer_than:{max(1, lookback)}d " + " ".join(f"-{n}" for n in NOISE)
    ids, tok = [], None
    while True:
        r = s.users().messages().list(userId="me", q=q, maxResults=100, pageToken=tok).execute()
        ids += [m["id"] for m in r.get("messages", [])]
        tok = r.get("nextPageToken")
        if not tok:
            break
    out = []
    for mid in ids:
        full = s.users().messages().get(userId="me", id=mid, format="full").execute()
        payload = full.get("payload", {})
        hdr = {h["name"]: h["value"] for h in payload.get("headers", [])}
        names, text = parts_info(payload)
        out.append({"id": mid, "hdr": hdr, "snippet": full.get("snippet", ""),
                    "attachments": names, "body": text})
    return out


def tally(items: list[dict]) -> tuple[list[dict], list[dict]]:
    """Chia thành (đáng ping, im lặng). Hàm thuần: cùng input luôn ra cùng kết quả."""
    cfg = load_config()
    keep, dropped = [], []
    for it in items:
        kind, why = classify(it["hdr"], it.get("attachments", []), it.get("body", ""), cfg)
        it["kind"], it["why"] = kind, why
        if not kind:
            it["skip"] = why_skipped(it["hdr"], it.get("attachments", []), it.get("body", ""), cfg)
            dropped.append(it)
            continue
        keep.append(it)
    return keep, dropped


def pretty_from(raw: str) -> str:
    name = re.sub(r"\s*<.*?>\s*", "", raw or "").strip().strip('"')
    name = re.sub(r"\s*\([^)]*\)\s*", " ", name)
    name = re.sub(r"\s+via\s+.*$", "", name, flags=re.I)
    return re.sub(r"\s+", " ", name).strip(", ")[:40] or raw


def alert_text(it: dict) -> str:
    h, snip = it["hdr"], re.sub(r"\s+", " ", it["snippet"])[:200]
    head = "📅 *Lời mời họp*" if it["kind"] == "invite" else "📄 *Review tài liệu dự án*"
    return (f"{head}\n"
            f"*{pretty_from(h.get('From'))}* — {(h.get('Subject') or '')[:95]}\n"
            f"_{h.get('Date', '')[:22]}_\n"
            f"vì: {', '.join(it['why'])}\n"
            f"↳ {snip}")


def send(text: str) -> None:
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False, encoding="utf-8") as fh:
        fh.write(text)
        path = fh.name
    r = subprocess.run([sys.executable, str(SEND), "--space", DM_HOANG, "--text-file", path],
                       capture_output=True, text=True)
    print(f"   ping: exit={r.returncode} {r.stdout.strip()[:100]}")
    Path(path).unlink(missing_ok=True)


def main() -> int:
    p = argparse.ArgumentParser(description="Ping mail moi hop / review tai lieu cho Hoang")
    p.add_argument("--lookback", type=int, default=2)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--explain", action="store_true")
    p.add_argument("--reset-seen", action="store_true")
    p.add_argument("--init-alerts-hours", type=int, default=12)
    a = p.parse_args()

    st = load_state()
    if a.reset_seen:
        save_state({"seen": {}})
        print("   da xoa baseline")
        return 0

    items = candidates(gmail.svc(), a.lookback)
    ranked, dropped = tally(items)

    if a.explain:
        print(f"   {'loai':8} {'tu':26} tieu de / ly do")
        for it in ranked:
            h = it["hdr"]
            print(f"   {it['kind']:8} {pretty_from(h.get('From'))[:26]:26} "
                  f"{(h.get('Subject') or '')[:52]}")
            print(f"        vì: {', '.join(it['why'])}")
        print(f"   -- im lang {len(dropped)} thu:")
        for it in dropped[:8]:
            print(f"        [{(it['hdr'].get('Subject') or '')[:46]}] <- {it['skip']}")
        print(f"   ({len(ranked)}/{len(items)} thu se ping)")
        return 0

    first_run = not st["seen"]
    cut = dt.datetime.now(dt.timezone.utc) - dt.timedelta(hours=a.init_alerts_hours)
    fresh = 0
    for it in ranked:
        if it["id"] in st["seen"]:
            continue
        if first_run and _older_than(it["hdr"].get("Date", ""), cut):
            st["seen"][it["id"]] = dt.date.today().isoformat()
            continue
        if a.dry_run:
            print(alert_text(it))
        else:
            send(alert_text(it))
        fresh += 1
        st["seen"][it["id"]] = dt.date.today().isoformat()
    print(f"   xet {len(items)} | ping {fresh} | im lang {len(dropped)}")
    if not a.dry_run:
        save_state(st)
    return 0


def _older_than(date_hdr: str, cut: dt.datetime) -> bool:
    try:
        d = dt.datetime.strptime(date_hdr[:25].strip(), "%a, %d %b %Y %H:%M:%S")
        return d.replace(tzinfo=dt.timezone.utc) < cut
    except Exception:
        return False


if __name__ == "__main__":
    sys.exit(main())
